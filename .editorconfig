root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
indent_style = space
indent_size = 4

[*.cs]
# Общие правила форматирования
csharp_new_line_before_open_brace = all
csharp_indent_case_contents = true
csharp_indent_labels = one_less_than_current

# Фигурные скобки — НЕ требуем (IDE0011 не нужен для однострочных if)
csharp_prefer_braces = false:silent

# Модификаторы доступа — требуем явно
dotnet_style_require_accessibility_modifiers = always:warning
dotnet_style_readonly_field = true:suggestion

# var — предпочитаем ЯВНЫЙ тип (это включает IDE0008)
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion
csharp_style_var_elsewhere = false:suggestion

# Коллекции — не навязываем синтаксис
csharp_style_prefer_collection_expression = false:silent

# Отключаем шумные подсказки
dotnet_diagnostic.IDE0290.severity = none       # primary constructors
dotnet_diagnostic.IDE0180.severity = none       # tuple swap
dotnet_diagnostic.CA1822.severity = none        # Mark members as static
dotnet_diagnostic.IDE0060.severity = none       # Unused parameter
dotnet_diagnostic.CA1834.severity = none        # StringBuilder.Append(char)
dotnet_diagnostic.IDE0130.severity = none       # namespace vs folder
dotnet_diagnostic.IDE0300.severity = none       # simplify collection init
dotnet_diagnostic.IDE0301.severity = none       # simplify empty collection init
dotnet_diagnostic.IDE0011.severity = none       # add braces to if
dotnet_diagnostic.IDE0028.severity = none       # collection initializer simplification